# =============================================================================
# AI Fitness Application — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values before deployment/running.

# -------------------------------------------------------------
# Google Gemini AI Integration
# -------------------------------------------------------------
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# -------------------------------------------------------------
# PostgreSQL Database (User Service)
# -------------------------------------------------------------
POSTGRES_DB=fitness-micro-user
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fitness-micro-user
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password

# -------------------------------------------------------------
# MongoDB (Activity & AI Services)
# -------------------------------------------------------------
# For local Docker: mongodb://localhost:27017/aiactivityfitness
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/aiactivityfitness?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/aiactivityfitness
SPRING_DATA_MONGODB_DATABASE=aiactivityfitness

# -------------------------------------------------------------
# Apache Kafka
# -------------------------------------------------------------
# For local Docker: localhost:9092, PLAINTEXT
# For Upstash / Confluent: xxxxx.upstash.io:9092, SASL_SSL
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
SPRING_KAFKA_SASL_MECHANISM=SCRAM-SHA-256
SPRING_KAFKA_SASL_JAAS_CONFIG=
KAFKA_TOPIC_NAME=activity-events

# -------------------------------------------------------------
# Keycloak Authentication Server
# -------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_this_admin_password
KEYCLOAK_URL=http://localhost:8181
KEYCLOAK_REALM=fitness-app
KEYCLOAK_CLIENT_ID=oauth2-pkce-client
KEYCLOAK_JWK_URI=http://localhost:8181/realms/fitness-app/protocol/openid-connect/certs

# -------------------------------------------------------------
# Service Discovery & Config
# -------------------------------------------------------------
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
CONFIG_SERVER_URL=http://localhost:8888

# -------------------------------------------------------------
# Frontend URLs
# -------------------------------------------------------------
VITE_API_URL=http://localhost:8080/api
VITE_KEYCLOAK_URL=http://localhost:8181
VITE_KEYCLOAK_REALM=fitness-app
VITE_KEYCLOAK_CLIENT_ID=oauth2-pkce-client
VITE_REDIRECT_URI=http://localhost:5173

